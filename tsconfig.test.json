{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/types/assets.d.ts",
    "src/types/vendor.d.ts",
    "types/**/*.d.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "test/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "e2e"
  ]
}
